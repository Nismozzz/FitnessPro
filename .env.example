# 复制为 .env 后填写
LLM_API_KEY=
FAST_LLM_API_KEY=
EMBEDDING_API_KEY=
RERANKER_API_KEY=

# 生成方式：python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# 可选：覆盖 config.yml 中的数据库
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/fitnesspro

# 联网搜索 deepseek_research 默认复用上面的 LLM_API_KEY（须为 DeepSeek 官方 Key）
# 若要单独配置：将 config.yml 的 web_search.api_key_env 改为 DEEPSEEK_SEARCH_API_KEY
# DEEPSEEK_SEARCH_API_KEY=
